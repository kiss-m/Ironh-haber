; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Iron Harbor"
config/description="Portrait naval fortress defense for Android."
config/version="0.6.0"
run/main_scene="res://meta/splash/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.043, 0.165, 0.247, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
DataRegistry="*res://autoload/data_registry.gd"
GameState="*res://autoload/game_state.gd"
SceneRouter="*res://autoload/scene_router.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=540
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/translations.sk.translation", "res://locale/translations.en.translation")

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
