{
  "name": "kvant",
  "private": true,
  "version": "0.1.0",
  "description": "Personal micro-learning PWA that replaces doomscrolling.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vite",
    "prebuild": "npm run content:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "node scripts/content-build.ts",
    "icons": "node scripts/generate-icons.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
